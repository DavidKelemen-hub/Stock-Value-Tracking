<Window x:Class="StockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <DockPanel Grid.Column="0">
            <TextBox
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Height="30"
            VerticalContentAlignment="Center"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            />

            <ListBox
            Name="CompaniesListBox"
            ItemsSource="{Binding CompaniesViewModel.Companies}"
            SelectedItem="{Binding CompaniesViewModel.SelectedCompany, Mode=TwoWay}"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="Name"/>
                                    <Binding Path="Symbol"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right panel (placeholder) -->
        <Border Grid.Column="2" Padding="12" BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="Bold"
                       Text="{Binding CompaniesViewModel.SelectedCompany.Name}" />
                <TextBlock Opacity="0.7"
                       Text="{Binding CompaniesViewModel.SelectedCompany.Symbol}" />

                <!-- Your chart goes here -->
                <TextBlock Margin="0,16,0,0" 
                       Text="{Binding ClosePrice}"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>
