<Window x:Class="StockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    
    
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <DockPanel Grid.Column="0">
            <TextBox
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Height="30"
            VerticalContentAlignment="Center"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            />

            <ListBox
            ItemsSource="{Binding Companies}"
            SelectedItem="{Binding SelectedCompany}"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="Name"/>
                                    <Binding Path="Symbol"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right panel (placeholder) -->
        <Border Grid.Column="2"
        Padding="12"
        BorderThickness="1">

            <!-- UN SINGUR child -->
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="RangeButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="Gray"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Margin" Value="0,0,12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                            Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                            To="#8ab4f8"
                            Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                            Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                            To="Gray"
                            Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>


                <TextBlock FontSize="18"
                   FontWeight="Bold"
                   Text="{Binding SelectedCompany.Name}" />

                <TextBlock Opacity="0.7"
                   Text="{Binding SelectedCompany.Symbol}" />

                <!-- Range buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="5D"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="5D"/>

                    <Button Content="1M"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="1M"/>

                    <Button Content="6M"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="6M"/>

                    <Button Content="YTD" Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="YTD"/>

                    <Button Content="1Y"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="1Y"/>

                    <Button Content="5Y"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="5Y"/>

                    <Button Content="Max" Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="Max"/>
                </StackPanel>

                <!-- Chart lipit -->
                <oxy:PlotView Model="{Binding ChartData}"
              Height="300"
              Margin="0"/>


                <!-- Close price -->
                <TextBlock Margin="0,16,0,0"
                   Text="{Binding ClosePrice}" />

            </StackPanel>
        </Border>

    </Grid>

</Window>
    
    
