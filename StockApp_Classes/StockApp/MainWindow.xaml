<Window x:Class="StockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:local="clr-namespace:StockApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <DockPanel Grid.Column="0">
            <TextBox
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Height="30"
            VerticalContentAlignment="Center"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            />

            <ListBox
            ItemsSource="{Binding Companies}"
            SelectedItem="{Binding SelectedCompany}"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="Name"/>
                                    <Binding Path="Symbol"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right panel (placeholder) -->
        <Border Grid.Column="2"
        Padding="12"
        BorderThickness="1">

            <!-- UN SINGUR child -->
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="RangeButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="Gray"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Margin" Value="0,0,12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                            Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                            To="#8ab4f8"
                            Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                            Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                            To="Gray"
                            Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                    <TextBlock FontSize="18"
                   FontWeight="Bold"
                   Text="{Binding SelectedCompany.Name}" />

                    <TextBlock Opacity="0.7"
                               FontSize="18"
                               Margin="8,0,0,0"
                    Text="{Binding SelectedCompany.Symbol, StringFormat={}({0})}" />
                    
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Margin="8,0,0,0"
                               Text="{Binding CurrentPrice, StringFormat={}{0}$}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock FontSize="14"
                           Margin="8,0,0,0"
                           Text="{Binding PriceVariation}"
                           Foreground="{Binding TextColor}"/>
                <TextBlock FontSize="14"
                           Margin="8,0,0,0"
                           Text="{Binding PercentageVariation, StringFormat={}({0}%)}"
                           Foreground="{Binding TextColor}"/>

                 <TextBlock FontSize="14"
                            Margin="8,0,0,0"
                            Text="{Binding RangeText}"
                            Foreground="{Binding TextColor}"/>
                </StackPanel>

                    <!-- Range buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="5D"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="5D"/>

                    <Button Content="1M"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="1M"/>

                    <Button Content="6M"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="6M"/>

                    <Button Content="YTD" Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="YTD"/>

                    <Button Content="1Y"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="1Y"/>

                    <Button Content="5Y"  Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0,0,8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="5Y"/>

                    <Button Content="Max" Background="Black" Foreground="Gray"
                            Width="48" Height="28" Margin="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command ="{Binding RangeClickedCommand}"
                            CommandParameter="Max"/>
                </StackPanel>

            <!-- Chart lipit -->
                <oxy:PlotView Model="{Binding ChartData}"
                    Height="300"
                    Margin="0"/>

                    <StackPanel Orientation="Vertical" Margin="0,12,12,0">
                                <Label Content="Highest Price"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                    <TextBlock FontSize="14"
                                   Margin="8,0,0,0"
                                   Foreground="Black"
                                   Text="{Binding HighestPrice, StringFormat={}{0}$}"/>
                </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,12,12,0">
                        
                        <Label Content="Lowest Price"
                                FontWeight="Bold"
                                VerticalAlignment="Center"/>
                    <TextBlock FontSize="14"
                               Margin="8,0,0,0"
                               Foreground="Black"
                               Text="{Binding LowestPrice, StringFormat={}{0}$}"/>
                    </StackPanel>

                <Button Content="{Binding PerformanceSelector}"
        Command="{Binding PerformanceSelectorCommand}"
        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
        Width="250"
        Height="32"
        Margin="4"
        FontSize="13"
        FontWeight="SemiBold"
        Foreground="#333333"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                    Background="#F2F2F2"
                    BorderBrush="#C8C8C8"
                    BorderThickness="1"
                    CornerRadius="6">
                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#E6E6E6"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#DADADA"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Background" Value="#F7F7F7"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <!-- Top Performers -->
                <ItemsControl ItemsSource="{Binding CompaniesPerformance}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"
                         Rows="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6"
                    Padding="10"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#22000000"
                    Background="#FAFAFA">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Name (Symbol) -->
                                    <TextBlock Grid.Row="0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <!-- Name -->
                                                <Binding Path="Name"/>
                                                <!-- Symbol -->
                                                <Binding Path="Symbol"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- PriceChange (PercentageChange) -->
                                    <TextBlock Grid.Row="2"
                               FontSize="12"
                               FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <!-- PriceChange -->
                                                <Binding Path="PercentChange"/>
                                                <!-- PercentageChange -->
                                                <Binding Path="PriceChange"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Top Performers -->
                
            </StackPanel>
        </Border>

    </Grid>

</Window>
    
    
