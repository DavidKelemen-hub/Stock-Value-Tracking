<Window x:Class="StockApp.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="420" Height="280"
        ShowInTaskbar="False">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="Root"
            Background="#FFF5F0"
            CornerRadius="16"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0"
                              Color="#CCBBAA" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- App title -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="SP500"
                           FontSize="38" FontWeight="Bold"
                           Foreground="#1A1A1A"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="STOCK APPLICATION"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Spinner -->
            <Canvas Grid.Row="1"
                    Width="48" Height="48"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
                <Ellipse Width="48" Height="48"
                         Stroke="#E8D5C4" StrokeThickness="4"/>
                <Ellipse x:Name="SpinnerArc"
                         Width="48" Height="48"
                         StrokeThickness="4"
                         StrokeDashArray="8 24"
                         StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E8824A" Offset="0"/>
                            <GradientStop Color="#F0A875" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="SpinnerRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0" To="360"
                                        Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Canvas>

            <!-- Status text -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Text="Loading..."
                       FontSize="12"
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0"/>

            <!-- Version -->
            <TextBlock Grid.Row="3"
                       Text="v1.0.0"
                       FontSize="10"
                       Foreground="#CCCCCC"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>