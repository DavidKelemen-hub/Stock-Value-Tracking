<UserControl x:Class="StockApp.PerformersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StockApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Button selector -->
        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left text -->
            <TextBlock Grid.Column="0"
Opacity="0.7"
FontSize="18"
VerticalAlignment="Center"
HorizontalAlignment="Left"
FontWeight="Bold"
Text="{Binding PerformerRangeText,
       StringFormat={}Top/Low Performers from {0}}" />

            <!-- Center controls -->
            <StackPanel Grid.Column="1"
 Orientation="Horizontal"
 VerticalAlignment="Center">

                <TextBlock Text="Low Performers"
    Foreground="IndianRed"
    FontSize="14"
    Margin="0,0,10,0"/>

                <ToggleButton Style="{StaticResource SwitchToggle}"
       IsChecked="{Binding ShowTop10}" />

                <TextBlock Text="Top Performers"
    Foreground="LimeGreen"
    FontSize="14"
    Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>


        <!-- Button selector -->

        <!-- Top Performers -->
        <ItemsControl ItemsSource="{Binding CompaniesPerformance}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"
          Rows="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="6"
     Padding="10"
     CornerRadius="10"
     BorderThickness="1"
     BorderBrush="#22000000"
     Background="#FAFAFA">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Name (Symbol) -->
                            <TextBlock Grid.Row="0"
                FontSize="13"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ({1})">
                                        <!-- Name -->
                                        <Binding Path="Name"/>
                                        <!-- Symbol -->
                                        <Binding Path="Symbol"/>
                                    </MultiBinding>

                                </TextBlock.Text>
                            </TextBlock>

                            <!-- PriceChange (PercentageChange) -->
                            <TextBlock Grid.Row="2"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding DataContext.PerformersColor,RelativeSource={RelativeSource AncestorType=ItemsControl}}">

                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:+0.##;-0.##;0}% ({1:+0.##;-0.##;0}$)">
                                        <Binding Path="PercentChange"/>
                                        <Binding Path="PriceChange"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Top Performers -->
    </Grid>
</UserControl>
